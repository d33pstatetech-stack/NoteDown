{
  "name": "@localnotes/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply localnotes --local",
    "migrate:remote": "wrangler d1 migrations apply localnotes --remote",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts"
  },
  "dependencies": {
    "@localnotes/shared": "workspace:*",
    "better-auth": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0",
    "vitest": "^4.1.11",
    "@cloudflare/vitest-plugin": "^1.4.0"
  }
}
