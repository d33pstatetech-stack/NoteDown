{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteDown",
  "version": "0.1.0",
  "identifier": "com.notedown.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @localnotes/web run dev",
    "beforeBuildCommand": "pnpm --filter @localnotes/web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoteDown",
        "width": 1280,
        "height": 840,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost https://notedown-api.d33pstatetech.workers.dev http://127.0.0.1:8787 http://localhost:8787"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown notes",
    "longDescription": "Offline-first Markdown notes with a notebook tree, rendered preview and plain-Markdown export. Notes live in a local SQLite database and stay fully usable offline; the hosted backend adds optional sync between devices.",
    "publisher": "NoteDown",
    "copyright": "Copyright (c) NoteDown",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
