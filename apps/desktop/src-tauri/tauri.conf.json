{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Notes",
  "version": "0.1.0",
  "identifier": "com.localnotes.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @localnotes/web run dev",
    "beforeBuildCommand": "pnpm --filter @localnotes/web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Notes",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown notes",
    "longDescription": "Offline-first Markdown notes with a notebook tree, rendered preview and plain-Markdown export. Notes are stored in a local SQLite database; the hosted backend is optional.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
