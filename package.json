{
  "name": "localnotes",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Markdown notes (web + Tauri desktop) with a Cloudflare backend",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "test:rust": "cargo test --manifest-path crates/notes-store/Cargo.toml",
    "build": "pnpm -r --no-bail run build",
    "build:web": "pnpm --filter @localnotes/web run build",
    "dev:web": "pnpm --filter @localnotes/web run dev",
    "dev:desktop": "pnpm --filter @localnotes/desktop run dev",
    "typecheck:rust": "cargo check --manifest-path crates/notes-store/Cargo.toml",
    "typecheck:root": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.0.0",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
